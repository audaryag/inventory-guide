            "name": "qcNatureNoCapacity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    FGNatures = List.Distinct(List.RemoveNulls(dimFGAttr[Nature])),\n    CapTechs  = List.Distinct(List.RemoveNulls(varMWCapacity[Tech])),\n    Orphans   = List.Difference(FGNatures, CapTechs),\n    T         = Table.FromList(Orphans, Splitter.SplitByNothing(), {\"Nature\"}),\n    Typed     = Table.TransformColumnTypes(T, {{\"Nature\", type text}})\nin\n    Typed"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "isHidden": true
