            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Wb    = Excel.Workbook(File.Contents(pVarsFile), null, true),\n    Sh    = Table.SelectRows(Wb, each [Kind] = \"Sheet\"),\n    Slim  = Table.SelectColumns(Sh, {\"Item\",\"Data\"}),\n    Hdrs  = Table.AddColumn(Slim, \"Headers\", each\n                Text.Combine(List.Transform(\n                    Table.ColumnNames(Table.PromoteHeaders([Data], [PromoteAllScalars=true])),\n                    Text.From), \" | \"), type text),\n    Rows  = Table.AddColumn(Hdrs, \"DataRows\", each Table.RowCount([Data]) - 1, Int64.Type),\n    Out   = Table.RenameColumns(Table.SelectColumns(Rows, {\"Item\",\"Headers\",\"DataRows\"}),\n                {{\"Item\",\"SheetName\"}})\nin\n    Out"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "isHidden": true
