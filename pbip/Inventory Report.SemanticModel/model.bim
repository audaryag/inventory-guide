      {
        "name": "dimDate",
        "columns": [
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "MonthName",
            "dataType": "string",
            "sourceColumn": "MonthName",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "sortByColumn": "MonthSort"
          },
          {
            "name": "MonthSort",
            "dataType": "int64",
            "sourceColumn": "MonthSort",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "MonthIndex",
            "dataType": "int64",
            "sourceColumn": "MonthIndex",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "FY",
            "dataType": "string",
            "sourceColumn": "FY",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "FYMonthNo",
            "dataType": "int64",
            "sourceColumn": "FYMonthNo",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "QuarterNo",
            "dataType": "int64",
            "sourceColumn": "QuarterNo",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "sortByColumn": "QuarterSort"
          },
          {
            "name": "QuarterSort",
            "dataType": "int64",
            "sourceColumn": "QuarterSort",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "dimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    MinD   = Date.StartOfMonth(List.Min(factInventory[Month])),\n    MaxD   = Date.StartOfMonth(List.Max(factInventory[Month])),\n    Start  = #date(Date.Year(MinD) - (if Date.Month(MinD) < 4 then 1 else 0), 4, 1),\n    Count  = (Date.Year(MaxD) * 12 + Date.Month(MaxD))\n             - (Date.Year(Start) * 12 + Date.Month(Start)) + 1,\n    Months = List.Transform({0..Count - 1}, (i) => Date.AddMonths(Start, i)),\n    T      = Table.TransformColumnTypes(\n                 Table.FromList(Months, Splitter.SplitByNothing(), {\"Month\"}),\n                 {{\"Month\", type date}}),\n    MN     = Table.AddColumn(T, \"MonthName\", each Date.ToText([Month], \"MMM''yy\"), type text),\n    MS     = Table.AddColumn(MN, \"MonthSort\",\n                 each Date.Year([Month]) * 100 + Date.Month([Month]), Int64.Type),\n    MI     = Table.AddColumn(MS, \"MonthIndex\",\n                 each Date.Year([Month]) * 12 + Date.Month([Month]), Int64.Type),\n    FY     = Table.AddColumn(MI, \"FY\", each\n                 let y = if Date.Month([Month]) >= 4 then Date.Year([Month]) else Date.Year([Month]) - 1\n                 in  \"FY \" & Text.From(y) & \"-\" & Text.End(Text.From(y + 1), 2), type text),\n    // the year starts on 1 April, so Apr-Jun is Q1 and Jan-Mar is Q4\n    FYMonth = Table.AddColumn(FY, \"FYMonthNo\",\n                 each Number.Mod(Date.Month([Month]) - 4, 12) + 1, Int64.Type),\n    Qtr    = Table.AddColumn(FYMonth, \"QuarterNo\",\n                 each Number.RoundUp([FYMonthNo] / 3), Int64.Type),\n    QName  = Table.AddColumn(Qtr, \"Quarter\",\n                 each \"Q\" & Text.From([QuarterNo]) & \" \" & [FY], type text),\n    QSort  = Table.AddColumn(QName, \"QuarterSort\", each\n                 let y = if Date.Month([Month]) >= 4 then Date.Year([Month]) else Date.Year([Month]) - 1\n                 in  y * 10 + [QuarterNo], Int64.Type),\n    Out    = Table.SelectColumns(QSort,\n                 {\"Month\",\"MonthName\",\"MonthSort\",\"MonthIndex\",\"FY\",\n                  \"FYMonthNo\",\"QuarterNo\",\"Quarter\",\"QuarterSort\"})\nin\n    Out"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "dimNature",
        "columns": [
          {
            "name": "Nature",
            "dataType": "string",
            "sourceColumn": "Nature",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "dimNature",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    FromRM  = List.RemoveNulls(dimMaterialAttr[Nature]),\n    FromFG  = List.RemoveNulls(dimFGAttr[Nature]),\n    FromCap = List.RemoveNulls(varMWCapacity[Tech]),\n    All     = List.Distinct(List.Combine({FromRM, FromFG, FromCap})),\n    T       = Table.FromList(All, Splitter.SplitByNothing(), {\"Nature\"}),\n    Typed   = Table.TransformColumnTypes(T, {{\"Nature\", type text}})\nin\n    Typed"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "dimCapacity",
        "columns": [
          {
            "name": "Tech",
            "dataType": "string",
            "sourceColumn": "Tech",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "ValuationArea",
            "dataType": "string",
            "sourceColumn": "ValuationArea",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "CapacityMW",
            "dataType": "double",
            "sourceColumn": "CapacityMW",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "dimCapacity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Months   = List.Distinct(List.Sort(factInventory[Month])),\n    Combos   = Table.Distinct(Table.SelectColumns(varMWCapacity, {\"Tech\",\"ValuationArea\"})),\n    Grid     = Table.AddColumn(Combos, \"Month\", each Months),\n    Expanded = Table.ExpandListColumn(Grid, \"Month\"),\n    AsOf     = Table.AddColumn(Expanded, \"CapacityMW\", (row) =>\n                   let\n                       Rows   = Table.SelectRows(varMWCapacity, each\n                                    [Tech] = row[Tech]\n                                    and [ValuationArea] = row[ValuationArea]\n                                    and [EffectiveFrom] <= row[Month]),\n                       Sorted = Table.Sort(Rows, {{\"EffectiveFrom\", Order.Descending}}),\n                       Val    = try Sorted{0}[MW] otherwise null\n                   in  Val, type number),\n    Typed    = Table.TransformColumnTypes(AsOf, {{\"Month\", type date}})\nin\n    Typed"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "dimTBMaster",
        "columns": [
          {
