          },
          {
            "name": "MW Qty",
            "dataType": "double",
            "sourceColumn": "MW Qty",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Rate",
            "dataType": "double",
            "sourceColumn": "Rate",
            "summarizeBy": "none",
            "annotations": [
