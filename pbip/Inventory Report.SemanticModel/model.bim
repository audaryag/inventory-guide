              }
            ]
          },
          {
            "name": "TBSort",
            "dataType": "int64",
            "sourceColumn": "TBSort",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "factTB",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Mapped  = Table.NestedJoin(factTB_Staged, {\"GLAccount\"}, dimTBMaster, {\"GLAccount\"},\n                  \"tpl\", JoinKind.Inner),\n    Expand  = Table.ExpandTableColumn(Mapped, \"tpl\", {\"Nature\",\"TBPlant\",\"TBSort\"}),\n    // RM / FG / Consumables from whatever the Nature (or GL description) says\n    Bucket  = (n as any, d as any) as text =>\n                  let T = Text.Upper(Text.From(n ?? \"\") & \" \" & Text.From(d ?? \"\")) in\n                  if Text.Contains(T, \"FINISH\") or Text.Contains(T, \"FG\")\n                      then \"FG\"\n                  else if Text.Contains(T, \"CONSUM\") or Text.Contains(T, \"STORE\")\n                      or Text.Contains(T, \"SPARE\") or Text.Contains(T, \"PACK\")\n                      then \"Consumables\"\n                  else if Text.Contains(T, \"RAW\") or Text.Contains(T, \"RM\")\n                      or Text.Contains(T, \"WIP\") or Text.Contains(T, \"SEMI\")\n                      then \"RM\"\n                  else \"RM\",\n    Cat     = Table.AddColumn(Expand, \"Category\",\n                  each Bucket([Nature], [GLDesc]), type text),\n    // exact column list and types, so the table is the same shape every refresh\n    Wanted  = {\"SourceFile\",\"Month\",\"GLAccount\",\"GLDesc\",\"ProfitCentre\",\"ProfitCentreDesc\",\n               \"Amount\",\"PlantCode\",\"ValuationArea\",\"Nature\",\"TBPlant\",\"TBSort\",\"Category\"},\n    Padded  = List.Accumulate(List.Difference(Wanted, Table.ColumnNames(Cat)), Cat,\n                  (t, c) => Table.AddColumn(t, c, each null)),\n    Kept    = Table.SelectColumns(Padded, Wanted),\n    Typed   = Table.TransformColumnTypes(Kept, {\n                  {\"SourceFile\", type text}, {\"Month\", type date},\n                  {\"GLAccount\", type text}, {\"GLDesc\", type text},\n                  {\"ProfitCentre\", type text}, {\"ProfitCentreDesc\", type text},\n                  {\"Amount\", type number}, {\"PlantCode\", type text},\n                  {\"ValuationArea\", type text}, {\"Nature\", type text},\n                  {\"TBPlant\", type text}, {\"TBSort\", Int64.Type},\n                  {\"Category\", type text}})\nin\n    Typed"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "factTB_Unmapped",
        "columns": [
