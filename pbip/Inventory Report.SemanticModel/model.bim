                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "factTB_Unmapped",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Anti  = Table.NestedJoin(factTB_Staged, {\"GLAccount\"}, dimTBMaster, {\"GLAccount\"},\n                \"tpl\", JoinKind.LeftAnti),\n    Clean = Table.RemoveColumns(Anti, {\"tpl\"}),\n    Group = Table.Group(Clean, {\"GLAccount\",\"GLDesc\"},\n                {{\"Amount\", each List.Sum([Amount]), type number},\n                 {\"Rows\",   each Table.RowCount(_), Int64.Type}})\nin\n    Group"
            }
          }
        ],
        "annotations": [
          {
