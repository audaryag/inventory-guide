                "value": "Automatic"
              }
            ]
          },
          {
            "name": "INR_WP",
            "dataType": "double",
            "sourceColumn": "INR_WP",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "factInventory",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Combined = Table.Combine({factRM, factFG, factConble}),\n    Wanted   = {\"SourceFile\",\"ValuationArea\",\"Material\",\"MatKey\",\"MaterialDesc\",\n                \"FromDate\",\"ToDate\",\"OpenQty\",\"OpenVal\",\"ReceiptQty\",\"ReceiptVal\",\n                \"IssueQty\",\"IssueVal\",\"CloseQty\",\"CloseVal\",\"BaseUOM\",\"SpecialStock\",\n                \"Currency\",\"Month\",\"Category\",\"Nature\",\"GroupNature\",\"BOMStdQty\",\"Item\",\n                \"AttrMissing\",\"MW\",\"Rate\",\"RateParseFailed\",\"Mid\",\"Base\",\"INR_WP\"},\n    Padded   = List.Accumulate(List.Difference(Wanted, Table.ColumnNames(Combined)),\n                   Combined, (t, c) => Table.AddColumn(t, c, each null)),\n    Kept     = Table.SelectColumns(Padded, Wanted),\n    Typed    = Table.TransformColumnTypes(Kept, {\n                   {\"SourceFile\", type text}, {\"ValuationArea\", type text},\n                   {\"Material\", type text}, {\"MatKey\", type text},\n                   {\"MaterialDesc\", type text}, {\"FromDate\", type date},\n                   {\"ToDate\", type date}, {\"OpenQty\", type number},\n                   {\"OpenVal\", type number}, {\"ReceiptQty\", type number},\n                   {\"ReceiptVal\", type number}, {\"IssueQty\", type number},\n                   {\"IssueVal\", type number}, {\"CloseQty\", type number},\n                   {\"CloseVal\", type number}, {\"BaseUOM\", type text},\n                   {\"SpecialStock\", type text}, {\"Currency\", type text},\n                   {\"Month\", type date}, {\"Category\", type text},\n                   {\"Nature\", type text}, {\"GroupNature\", type text},\n                   {\"BOMStdQty\", type number}, {\"Item\", type text},\n                   {\"AttrMissing\", type logical}, {\"MW\", type number},\n                   {\"Rate\", type number}, {\"RateParseFailed\", type logical},\n                   {\"Mid\", type text}, {\"Base\", type text}, {\"INR_WP\", type number}}),\n    // the megawatt column is renamed because Power BI will not let a table hold a column\n    // and a measure with the same name, and the report needs the measure to be called MW\n    Renamed  = Table.RenameColumns(Typed, {{\"MW\", \"MW Qty\"}})\nin\n    Renamed"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Value ₹ Cr",
            "expression": "DIVIDE(SUM(factInventory[CloseVal]), 10000000)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "As On",
            "expression": "\"as on \" & FORMAT(EOMONTH(MAX(dimDate[Month]), 0), \"dd MMM yyyy\")",
            "displayFolder": "Report measures"
          },
          {
            "name": "Value ₹ Cr Title",
            "expression": "\"Value ₹ Cr \" & [As On]",
            "displayFolder": "Report measures"
          },
          {
            "name": "Opening Value ₹ Cr",
            "expression": "DIVIDE(SUM(factInventory[OpenVal]), 10000000)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Receipts ₹ Cr",
            "expression": "DIVIDE(SUM(factInventory[ReceiptVal]), 10000000)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Issues ₹ Cr",
            "expression": "DIVIDE(SUM(factInventory[IssueVal]), 10000000)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Closing Qty",
            "expression": "SUM(factInventory[CloseQty])",
            "formatString": "#,##0",
            "displayFolder": "Report measures"
          },
          {
            "name": "RM ₹ Cr",
            "expression": "CALCULATE([Value ₹ Cr], factInventory[Category] = \"RM\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "FG ₹ Cr",
            "expression": "CALCULATE([Value ₹ Cr], factInventory[Category] = \"FG\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Consumables ₹ Cr",
            "expression": "CALCULATE([Value ₹ Cr], factInventory[Category] = \"Consumables\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Share of Total %",
            "expression": "DIVIDE([Value ₹ Cr], CALCULATE([Value ₹ Cr], ALL(factInventory[Category])))",
            "formatString": "0.0%",
            "displayFolder": "Report measures"
          },
          {
            "name": "MW",
            "expression": "SUM(factInventory[MW Qty])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "FG MW",
            "expression": "CALCULATE([MW], factInventory[Category] = \"FG\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Capacity MW",
            "expression": "SUM(dimCapacity[CapacityMW])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Capacity MW (plant)",
            "expression": "CALCULATE(SUM(dimCapacity[CapacityMW]), REMOVEFILTERS(dimNature))",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Days of Inventory",
            "expression": "VAR Cap = IF(ISBLANK([Capacity MW]), [Capacity MW (plant)], [Capacity MW])\nRETURN DIVIDE([MW], Cap)",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "FG Days",
            "expression": "DIVIDE([FG MW], [Capacity MW])",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "INR per Wp",
            "expression": "SUM(factInventory[INR_WP])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Value ₹ Cr LM",
            "expression": "VAR PrevIdx = MAX(dimDate[MonthIndex]) - 1\nRETURN CALCULATE([Value ₹ Cr], ALL(dimDate), dimDate[MonthIndex] = PrevIdx)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Value ₹ Cr vs LM",
            "expression": "[Value ₹ Cr] - [Value ₹ Cr LM]",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Value ₹ Cr % vs LM",
            "expression": "DIVIDE([Value ₹ Cr vs LM], [Value ₹ Cr LM])",
            "formatString": "0.0%",
            "displayFolder": "Report measures"
          },
          {
            "name": "Value ₹ Cr LY",
            "expression": "VAR PrevIdx = MAX(dimDate[MonthIndex]) - 12\nRETURN CALCULATE([Value ₹ Cr], ALL(dimDate), dimDate[MonthIndex] = PrevIdx)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Value ₹ Cr % vs LY",
            "expression": "DIVIDE([Value ₹ Cr] - [Value ₹ Cr LY], [Value ₹ Cr LY])",
            "formatString": "0.0%",
            "displayFolder": "Report measures"
          },
          {
            "name": "MW LM",
            "expression": "VAR PrevIdx = MAX(dimDate[MonthIndex]) - 1\nRETURN CALCULATE([MW], ALL(dimDate), dimDate[MonthIndex] = PrevIdx)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "MW vs LM",
            "expression": "[MW] - [MW LM]",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Days LM",
            "expression": "VAR PrevIdx = MAX(dimDate[MonthIndex]) - 1\nRETURN CALCULATE([Days of Inventory], ALL(dimDate), dimDate[MonthIndex] = PrevIdx)",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "Days vs LM",
            "expression": "[Days of Inventory] - [Days LM]",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "Avg Value ₹ Cr",
            "expression": "AVERAGEX(VALUES(dimDate[MonthIndex]), [Value ₹ Cr])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Peak Value ₹ Cr",
            "expression": "MAXX(VALUES(dimDate[MonthIndex]), [Value ₹ Cr])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Latest Month Value ₹ Cr",
            "expression": "VAR LastIdx = CALCULATE(MAX(dimDate[MonthIndex]), ALLSELECTED(dimDate))\nRETURN CALCULATE([Value ₹ Cr], dimDate[MonthIndex] = LastIdx)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "TB ₹ Cr",
            "expression": "DIVIDE(SUM(factTB[Amount]), 10000000)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Difference ₹ Cr",
            "expression": "[TB ₹ Cr] - [Value ₹ Cr]",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Difference %",
            "expression": "DIVIDE([Difference ₹ Cr], [TB ₹ Cr])",
            "formatString": "0.0%",
            "displayFolder": "Report measures"
          },
          {
            "name": "Stock Recon ₹ Cr",
            "expression": "[Opening Value ₹ Cr] + [Receipts ₹ Cr] - [Issues ₹ Cr] - [Value ₹ Cr]",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Rows Missing Attr",
            "expression": "CALCULATE(COUNTROWS(factInventory), factInventory[AttrMissing] = TRUE())",
            "formatString": "#,##0",
            "displayFolder": "Report measures"
          },
          {
            "name": "Unmapped TB ₹ Cr",
            "expression": "DIVIDE(SUM(factTB_Unmapped[Amount]), 10000000)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Days",
            "expression": "[Days of Inventory]",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "Summary Value ₹ Cr",
            "expression": "SWITCH(SELECTEDVALUE(dimMetric[Metric]),\n    \"Inventory (TB)\",   [TB ₹ Cr],\n    \"Inventory (MB5B)\", [Value ₹ Cr],\n    \"Difference\",       [Difference ₹ Cr],\n    [Value ₹ Cr])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Unit Value",
            "expression": "SWITCH(SELECTEDVALUE(dimMeasure[Measure]),\n    \"MW\",      [MW],\n    \"In ₹ Cr\", [Value ₹ Cr],\n    \"In Days\", [Days],\n    [Value ₹ Cr])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Last 4 Months",
            "expression": "VAR LastIdx = CALCULATE(MAX(dimDate[MonthIndex]), ALL(dimDate))\nRETURN IF(MAX(dimDate[MonthIndex]) > LastIdx - 4, 1, 0)",
            "formatString": "#,##0",
            "displayFolder": "Report measures"
          },
          {
            "name": "Latest Month Index",
            "expression": "CALCULATE(MAX(dimDate[MonthIndex]), REMOVEFILTERS())",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "As On Text",
            "expression": "\"As on \" & CALCULATE(MAX(dimDate[MonthName]), REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker Rs Cr",
            "expression": "CALCULATE([Value ₹ Cr], REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index])",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker RM Rs Cr",
            "expression": "CALCULATE([Value ₹ Cr], REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index], dimCategory[Category] = \"RM\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker FG Rs Cr",
            "expression": "CALCULATE([Value ₹ Cr], REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index], dimCategory[Category] = \"FG\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker Consumables Rs Cr",
            "expression": "CALCULATE([Value ₹ Cr], REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index], dimCategory[Category] = \"Consumables\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker 1900 Rs Cr",
            "expression": "CALCULATE([Value ₹ Cr], REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index], dimPlant[ValuationArea] = \"1900\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker 1902 Rs Cr",
            "expression": "CALCULATE([Value ₹ Cr], REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index], dimPlant[ValuationArea] = \"1902\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker 1905 Rs Cr",
            "expression": "CALCULATE([Value ₹ Cr], REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index], dimPlant[ValuationArea] = \"1905\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker Prev Rs Cr",
            "expression": "CALCULATE([Value ₹ Cr], REMOVEFILTERS(), dimDate[MonthIndex] = [Latest Month Index] - 1)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker Change Rs Cr",
            "expression": "[Ticker Rs Cr] - [Ticker Prev Rs Cr]",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker Change %",
            "expression": "DIVIDE([Ticker Change Rs Cr], [Ticker Prev Rs Cr])",
            "formatString": "0.0%",
            "displayFolder": "Report measures"
          },
          {
            "name": "Ticker Change Text",
            "expression": "IF(\n    ISBLANK([Ticker Prev Rs Cr]),\n    \"No earlier month to compare\",\n    FORMAT([Ticker Change Rs Cr], \"+#,##0.0;-#,##0.0\") & \" Rs Cr.   (\"\n        & FORMAT([Ticker Change %], \"+0.0%;-0.0%\") & \")\"\n)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Inventory Rs Cr",
            "expression": "IF(\n    SELECTEDVALUE('Period'[Period Order]) = 1,\n    AVERAGEX(VALUES(dimDate[MonthIndex]), [Value ₹ Cr]),\n    [Value ₹ Cr]\n)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "In Window",
            "expression": "VAR Mode = SELECTEDVALUE('Period'[Period Order], 0)\nVAR Picked = IF(Mode = 1, ISFILTERED(dimDate[Quarter]), ISFILTERED(dimDate[MonthName]))\nVAR Keep = IF(Mode = 1, 4, IF(Picked, 5, 4))\nVAR Place =\n    IF(\n        Mode = 1,\n        RANKX(ALLSELECTED(dimDate[QuarterSort]), CALCULATE(MAX(dimDate[QuarterSort])), , DESC),\n        RANKX(ALLSELECTED(dimDate[MonthIndex]), CALCULATE(MAX(dimDate[MonthIndex])), , DESC)\n    )\nVAR MarchIdx =\n    CALCULATE(\n        MAX(dimDate[MonthIndex]),\n        REMOVEFILTERS(dimDate),\n        dimDate[FYMonthNo] = 12,\n        dimDate[MonthIndex] <= [Latest Month Index]\n    )\nVAR IsMarch =\n    IF(Mode <> 1 && NOT Picked && MAX(dimDate[MonthIndex]) = MarchIdx, 1, 0)\nRETURN IF(Place <= Keep || IsMarch = 1, 1, 0)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "MW % vs LM",
            "expression": "DIVIDE([MW] - [MW LM], [MW LM])",
            "formatString": "0.0%",
            "displayFolder": "Report measures"
          },
          {
            "name": "RM MW",
            "expression": "CALCULATE([MW], factInventory[Category] = \"RM\")",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "RM Days",
            "expression": "DIVIDE([RM MW], [Capacity MW (plant)])",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "Total Days (RM + FG)",
            "expression": "DIVIDE([RM MW] + [FG MW], [Capacity MW (plant)])",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "RM Days All Plants",
            "expression": "VAR M = CALCULATE([RM MW], REMOVEFILTERS(dimPlant))\nVAR Cap = CALCULATE([Capacity MW (plant)], REMOVEFILTERS(dimPlant))\nRETURN DIVIDE(M, Cap)",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "RM Days All Plants by Period",
            "expression": "IF(\n    SELECTEDVALUE('Period'[Period Order]) = 1,\n    AVERAGEX(VALUES(dimDate[MonthIndex]), [RM Days All Plants]),\n    [RM Days All Plants]\n)",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "In Last 12",
            "expression": "VAR LastM = [Latest Month Index]\nVAR ThisM = MAX(dimDate[MonthIndex])\nRETURN IF(ThisM > LastM - 12 && ThisM <= LastM, 1, 0)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Period Title",
            "expression": "IF(\n    SELECTEDVALUE('Period'[Period Order]) = 1,\n    \"Inventory by Quarter (Rs Cr., Average of Month-Ends)\",\n    \"Inventory by Month (Rs Cr.)\"\n)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Summary Value Rs Cr",
            "expression": "IF(\n    SELECTEDVALUE('Period'[Period Order]) = 1,\n    AVERAGEX(VALUES(dimDate[MonthIndex]), [Summary Value ₹ Cr]),\n    [Summary Value ₹ Cr]\n)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "In Summary Window",
            "expression": "VAR Mode = SELECTEDVALUE('Period'[Period Order], 0)\nVAR Picked =\n    IF(\n        Mode = 1,\n        COUNTROWS(ALLSELECTED(dimDate[QuarterSort])),\n        COUNTROWS(ALLSELECTED(dimDate[MonthIndex]))\n    )\nVAR Chosen = IF(Mode = 1, ISFILTERED(dimDate[Quarter]), ISFILTERED(dimDate[MonthName]))\nVAR Keep = IF(Chosen, MIN(Picked, 12), 4)\nVAR Place =\n    IF(\n        Mode = 1,\n        RANKX(ALLSELECTED(dimDate[QuarterSort]), CALCULATE(MAX(dimDate[QuarterSort])), , DESC),\n        RANKX(ALLSELECTED(dimDate[MonthIndex]), CALCULATE(MAX(dimDate[MonthIndex])), , DESC)\n    )\nRETURN IF(Place <= Keep, 1, 0)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "TB Inventory Rs Cr",
            "expression": "IF(\n    SELECTEDVALUE('Period'[Period Order]) = 1,\n    AVERAGEX(VALUES(dimDate[MonthIndex]), [TB ₹ Cr]),\n    [TB ₹ Cr]\n)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Difference Inventory Rs Cr",
            "expression": "[TB Inventory Rs Cr] - [Inventory Rs Cr]",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Difference Inventory %",
            "expression": "DIVIDE([Difference Inventory Rs Cr], [TB Inventory Rs Cr])",
            "formatString": "0.0%",
            "displayFolder": "Report measures"
          },
          {
            "name": "Unit Value by Period",
            "expression": "IF(\n    SELECTEDVALUE('Period'[Period Order]) = 1,\n    AVERAGEX(VALUES(dimDate[MonthIndex]), [Unit Value]),\n    [Unit Value]\n)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "In Latest Month",
            "expression": "IF(MAX(dimDate[MonthIndex]) = [Latest Month Index], 1, 0)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          },
          {
            "name": "Days by Period",
            "expression": "IF(\n    SELECTEDVALUE('Period'[Period Order]) = 1,\n    AVERAGEX(VALUES(dimDate[MonthIndex]), [Days]),\n    [Days]\n)",
            "formatString": "#,##0.0",
            "displayFolder": "Report measures"
          },
          {
            "name": "Summary Title",
            "expression": "IF(\n    SELECTEDVALUE('Period'[Period Order]) = 1,\n    \"Inventory (TB) · Inventory (MB5B) · Difference by Plant (Rs Cr., Average of Month-Ends)\",\n    \"Inventory (TB) · Inventory (MB5B) · Difference by Plant (Rs Cr.)\"\n)",
            "formatString": "#,##0.00",
            "displayFolder": "Report measures"
          }
        ]
      },
      {
