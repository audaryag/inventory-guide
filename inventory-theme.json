{
  "name": "Inventory Report",
  "dataColors": [
    "#1E6B3A",
    "#4FA45F",
    "#8CC63F",
    "#C0504D",
    "#2E7D6B",
    "#A7C957",
    "#155E38",
    "#6C6F76",
    "#7FB069",
    "#8A8F98"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B1F26",
  "tableAccent": "#1E6B3A",
  "good": "#1E6B3A",
  "neutral": "#8CC63F",
  "bad": "#C0504D",
  "textClasses": {
    "title": {
      "fontSize": 13,
      "fontFace": "Arial Bold",
      "color": "#1B1F26"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Arial Bold",
      "color": "#1B1F26"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Arial",
      "color": "#3C424C"
    },
    "callout": {
      "fontSize": 24,
      "fontFace": "Arial Bold",
      "color": "#1B1F26"
    },
    "largeTitle": {
      "fontSize": 16,
      "fontFace": "Arial Bold",
      "color": "#1B1F26"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E6EB"
              }
            },
            "radius": 6
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Arial Bold",
            "fontColor": {
              "solid": {
                "color": "#1B1F26"
              }
            },
            "alignment": "left"
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "fontFamily": "Arial",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#3C424C"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "fontFamily": "Arial",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#3C424C"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EDEFF3"
              }
            }
          }
        ],
        "legend": [
          {
            "fontFamily": "Arial",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#3C424C"
              }
            },
            "position": "TopCenter"
          }
        ],
        "labels": [
          {
            "fontFamily": "Arial",
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#3C424C"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Arial Bold",
            "fontSize": 20,
            "color": {
              "solid": {
                "color": "#1B1F26"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontFamily": "Arial",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#6C6F76"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F6F8FB"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F6F8FB"
              }
            }
          }
        ],
        "items": [
          {
            "fontFamily": "Arial",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#3C424C"
              }
            }
          }
        ],
        "header": [
          {
            "fontFamily": "Arial Bold",
            "fontSize": 11
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#EDEFF3"
              }
            },
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDEFF3"
              }
            },
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Arial Bold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1B1F26"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F0F3F8"
              }
            },
            "wordWrap": true,
            "autoSizeColumnWidth": true
          }
        ],
        "subTotals": [
          {
            "fontFamily": "Arial Bold",
            "rowSubtotals": true,
            "columnSubtotals": true
          }
        ],
        "values": [
          {
            "fontFamily": "Arial",
            "fontSize": 10,
            "wordWrap": true
          }
        ],
        "rowHeaders": [
          {
            "fontFamily": "Arial",
            "fontSize": 10,
            "wordWrap": true
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Arial Bold",
            "fontSize": 10,
            "backColor": {
              "solid": {
                "color": "#F0F3F8"
              }
            },
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontFamily": "Arial",
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
