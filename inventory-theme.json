{
  "name": "Inventory Green",
  "dataColors": [
    "#14532D",
    "#2E7D46",
    "#57A05C",
    "#8CC084",
    "#B7D9A8",
    "#0E7C7B",
    "#4C8C74",
    "#9AA79F",
    "#B3261E",
    "#6B7280"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A24",
  "tableAccent": "#14532D",
  "good": "#2E7D32",
  "neutral": "#8CC084",
  "bad": "#B3261E",
  "textClasses": {
    "title": {
      "fontSize": 13,
      "fontFace": "Arial Bold",
      "color": "#14532D"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Arial Bold",
      "color": "#14532D"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Arial",
      "color": "#1F2A24"
    },
    "callout": {
      "fontSize": 22,
      "fontFace": "Arial Bold",
      "color": "#1F2A24"
    },
    "largeTitle": {
      "fontSize": 16,
      "fontFace": "Arial Bold",
      "color": "#14532D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE7DC"
              }
            },
            "radius": 6
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Arial Bold",
            "fontColor": {
              "solid": {
                "color": "#14532D"
              }
            },
            "alignment": "left"
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "fontFamily": "Arial",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#3C424C"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "fontFamily": "Arial",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#3C424C"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EDEFF3"
              }
            }
          }
        ],
        "legend": [
          {
            "fontFamily": "Arial",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#3C424C"
              }
            },
            "position": "BottomCenter"
          }
        ],
        "labels": [
          {
            "fontFamily": "Arial",
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#3C424C"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Arial Bold",
            "fontSize": 20,
            "color": {
              "solid": {
                "color": "#14532D"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontFamily": "Arial",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#6C6F76"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "items": [
          {
            "fontFamily": "Arial",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#3C424C"
              }
            }
          }
        ],
        "header": [
          {
            "fontFamily": "Arial Bold",
            "fontSize": 11
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#EDEFF3"
              }
            },
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDEFF3"
              }
            },
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Arial Bold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#14532D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E7F1E7"
              }
            },
            "wordWrap": true,
            "autoSizeColumnWidth": true
          }
        ],
        "subTotals": [
          {
            "fontFamily": "Arial Bold",
            "rowSubtotals": true,
            "columnSubtotals": true
          }
        ],
        "values": [
          {
            "fontFamily": "Arial",
            "fontSize": 10,
            "wordWrap": true
          }
        ],
        "rowHeaders": [
          {
            "fontFamily": "Arial",
            "fontSize": 10,
            "wordWrap": true
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Arial Bold",
            "fontSize": 10,
            "backColor": {
              "solid": {
                "color": "#E7F1E7"
              }
            },
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontFamily": "Arial",
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EFF5EF"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}